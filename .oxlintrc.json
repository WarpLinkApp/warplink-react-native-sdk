{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "lib/",
    "node_modules/",
    "example/"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  }
}
